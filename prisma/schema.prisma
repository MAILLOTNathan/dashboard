// Prisma schema for the personal dashboard.
//
// Conventions (see AGENTS.md):
// - Financial amounts use an exact decimal type (Decimal(18, 2)), never floating point.
//   A negative amount is an outflow, a positive amount is an inflow.
// - Operation dates are stored as DATE (no time, no time zone).
// - Instants (creation, update, synchronisation) are stored as timestamptz, in UTC.
// - Currency is a 3-letter ISO 4217 code, EUR by default.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_CARD
  OTHER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

/// A property is not necessarily rented: `occupancy` is explicit.
enum PropertyOccupancy {
  RENTED
  VACANT
  OWNER_OCCUPIED
  SEASONAL
  OTHER
}

enum CashflowKind {
  INCOME
  EXPENSE
}

enum IntegrationProvider {
  GITHUB
  GITLAB
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

/// The lifecycle of one synchronisation attempt. `PARTIAL` means the run completed
/// but some repositories were left unread (the run bound, or a provider refusal):
/// their data is unknown, not empty.
enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/// The two levels of the salary calendar: a day is planned (the simulated budget),
/// then really worked (the amount actually earned). One state at a time.
enum WorkDayStatus {
  PLANNED
  WORKED
}

/// How often a recurring definition occurs. Only `MONTHLY` is offered today:
/// the column exists so another cadence would be a migration, not a redesign.
enum RecurrenceFrequency {
  MONTHLY
}

/// The lifecycle of one materialised occurrence. A decision is terminal — no state
/// returns to `PENDING` — so the audit trail never loses a step: a skipped or
/// dismissed échéance stays visible, and a confirmed one keeps its transaction.
enum RecurringOccurrenceStatus {
  PENDING
  CONFIRMED
  SKIPPED
  DISMISSED
}

/// The lifecycle of a goal. `ACHIEVED` and `ABANDONED` are explicit choices, never
/// derived: progress is a computed figure, the status is what the owner decided.
enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

/// The well-understood situations the alert engine watches. Deterministic rules only:
/// no statistical heuristics in the first pass.
enum AlertKind {
  LOW_BALANCE
  BUDGET_OVERRUN
  UNUSUAL_EXPENSE
  STALE_INTEGRATION
  OVERDUE_EVENT
}

/// The lifecycle of one alert. `DISMISSED` is the owner's choice and sticks while the
/// condition holds; `RESOLVED` means the condition stopped being true — a resolved
/// alert that triggers again reopens, a dismissed one waits for that resolution first.
enum AlertStatus {
  ACTIVE
  DISMISSED
  RESOLVED
}

/// An open issue and an open pull request arrive from the same provider endpoint;
/// they stay distinct because they call for different actions.
enum IssueKind {
  ISSUE
  PULL_REQUEST
}

/// Sole owner of the dashboard. No public sign-up: users are created by the seed script.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  accounts    Account[]
  categories  Category[]
  transactions Transaction[]
  budgets     Budget[]
  salarySetting SalarySetting?
  workDays    WorkDay[]
  recurringEntries RecurringEntry[]
  recurringOccurrences RecurringOccurrence[]
  goals       Goal[]
  properties  Property[]
  connections IntegrationConnection[]
  alerts      Alert[]
  alertRules  AlertRule[]
}

/// A manually tracked account. No banking credentials are ever stored here.
model Account {
  id        String      @id @default(cuid())
  userId    String
  name      String
  type      AccountType @default(CHECKING)
  currency  String      @default("EUR") @db.Char(3)
  archivedAt DateTime?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurringEntries RecurringEntry[]
  goals        Goal[]

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  kind      CategoryKind
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurringEntries RecurringEntry[]

  @@unique([userId, name, kind])
  @@index([userId])
}

model Transaction {
  id       String          @id @default(cuid())
  userId   String
  accountId String
  categoryId String?
  type     TransactionType
  label    String
  /// Signed amount in the account currency: negative for an outflow.
  amount   Decimal         @db.Decimal(18, 2)
  currency String          @default("EUR") @db.Char(3)
  /// Operation date, distinct from createdAt and from any synchronisation date.
  operationDate DateTime  @db.Date
  notes    String?
  /// Stable identifier of the source record, used to make imports re-runnable.
  externalRef String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cashflows PropertyCashflow[]
  recurringOccurrence RecurringOccurrence?

  @@unique([accountId, externalRef])
  @@index([userId, operationDate])
  @@index([userId, categoryId])
}

/// A planned amount for one category, one month and one currency.
///
/// The amount is a positive magnitude: the category's kind says whether this is a
/// spending envelope or an income target. Currencies are never converted, so the same
/// category may carry one budget per currency — and exactly one, which the unique
/// constraint enforces.
model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  year       Int
  /// 1-based month, as a human writes it.
  month      Int
  currency   String   @default("EUR") @db.Char(3)
  amount     Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, year, month, currency])
  @@index([userId, year, month])
}

/// The owner's wage, reduced to the one unit the simulation needs: an exact hourly
/// rate. Weekly and monthly amounts are only derived figures shown next to it (see
/// `salaryEquivalents`), never stored in those units.
model SalarySetting {
  id         String   @id @default(cuid())
  userId     String   @unique
  /// Exact hourly rate, in `currency`.
  hourlyRate Decimal  @db.Decimal(18, 2)
  /// Default length of a plannable day, in hours. Applies to future clicks only.
  hoursPerDay Decimal @db.Decimal(4, 2)
  currency   String   @default("EUR") @db.Char(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One clicked day of the salary calendar. The status is the level the owner reached:
/// `PLANNED` feeds the simulated budget, `WORKED` the real amount. One row per owner
/// and day, which the unique constraint enforces; the third click removes the row.
model WorkDay {
  id     String        @id @default(cuid())
  userId String
  date   DateTime      @db.Date
  status WorkDayStatus @default(PLANNED)
  /// Hours for this day, adjustable by half-hours.
  hours  Decimal       @db.Decimal(4, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// A recurring definition of an expected income or expense (rent, subscription, salary).
///
/// The definition never writes to the ledger by itself: it only describes a series, and
/// each occurrence must be confirmed explicitly — the confirmation goes through the same
/// creation path as a manually typed transaction. `amount` is a positive magnitude;
/// `type` carries the direction, the way a budget's category kind carries it.
model RecurringEntry {
  id         String              @id @default(cuid())
  userId     String
  accountId  String
  categoryId String?
  type       TransactionType
  label      String
  /// Planned magnitude, always positive; the sign comes from `type` at confirmation.
  amount     Decimal             @db.Decimal(18, 2)
  frequency  RecurrenceFrequency @default(MONTHLY)
  /// First day of the series; its day-of-month is the recurring day (31 → end of
  /// shorter months, see `occurrenceDatesForMonth`).
  startDate  DateTime            @db.Date
  /// Last day of the series, inclusive. Null means the series has no end.
  endDate    DateTime?           @db.Date
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  occurrences RecurringOccurrence[]

  @@index([userId])
}

/// One occurrence of a recurring definition, materialised for a month.
///
/// Created in bulk and idempotently when a month is opened; the unique
/// (recurringId, date) keeps a second opening from duplicating it. `transactionId` is
/// set by the confirmation and unique, so a replay cannot book the same occurrence
/// twice. Deleting that transaction deletes its occurrence row instead of leaving a
/// phantom "confirmed": opening the month again offers the échéance anew, which is
/// the honest reading of a booking that no longer exists.
model RecurringOccurrence {
  id            String                    @id @default(cuid())
  userId        String
  recurringId   String
  /// Calendar day of the occurrence, a `DATE` like every operation date.
  date          DateTime                  @db.Date
  status        RecurringOccurrenceStatus @default(PENDING)
  transactionId String?                   @unique
  /// When the confirm, skip or dismiss decision was taken. Null while pending.
  decidedAt     DateTime?                 @db.Timestamptz(3)
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @db.Timestamptz(3)

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurring   RecurringEntry @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  transaction Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([recurringId, date])
  @@index([userId, status, date])
}

/// A savings or repayment goal: a target amount in one currency, to be set aside (or
/// repaid) by a target date.
///
/// The current amount comes from exactly one source — a manual amount, or the recorded
/// balance of a linked account (`currentAmount` and `accountId` are mutually exclusive,
/// enforced by the input contract). With neither, progress is *unknown* and is read as
/// unknown, never as zero. A linked account must carry the goal's currency: no
/// conversion ever happens.
model Goal {
  id           String     @id @default(cuid())
  userId       String
  name         String
  targetAmount Decimal    @db.Decimal(18, 2)
  currency     String     @default("EUR") @db.Char(3)
  targetDate   DateTime   @db.Date
  status       GoalStatus @default(ACTIVE)
  /// Manual current amount, never negative; mutually exclusive with `accountId`.
  currentAmount Decimal?  @db.Decimal(18, 2)
  accountId    String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Property {
  id        String            @id @default(cuid())
  userId    String
  name      String
  address   String?
  occupancy PropertyOccupancy @default(VACANT)
  purchaseDate DateTime?      @db.Date
  saleDate  DateTime?         @db.Date
  notes     String?
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashflows PropertyCashflow[]

  @@unique([userId, name])
  @@index([userId])
}

/// A financial entry attached to a property.
///
/// Double-counting rule: `transactionId` and `amount` are mutually exclusive.
/// When the entry is linked to a transaction, the amount comes from the transaction
/// and `amount` stays null; property totals resolve the linked transaction instead
/// of adding a second amount.
model PropertyCashflow {
  id            String        @id @default(cuid())
  propertyId    String
  /// A transaction can be attached to at most one property.
  transactionId String?       @unique
  kind          CashflowKind
  /// Signed amount, only set for standalone entries (no linked transaction).
  amount        Decimal?      @db.Decimal(18, 2)
  currency      String        @default("EUR") @db.Char(3)
  label         String
  /// Expected date for a charge or a rent; distinct from the settlement date.
  dueDate       DateTime?     @db.Date
  settledAt     DateTime?     @db.Date
  notes         String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([propertyId, dueDate])
}

/// Read-only connection to a GitHub or GitLab instance.
/// Secrets are never returned to the browser; `credentialsCiphertext` holds the
/// encrypted token (AES-256-GCM, key from INTEGRATION_ENCRYPTION_KEY).
model IntegrationConnection {
  id       String              @id @default(cuid())
  userId   String
  provider IntegrationProvider
  /// GitLab may be self-hosted. Empty string means the provider's public instance,
  /// which keeps the uniqueness constraint reliable (NULL is not comparable in PostgreSQL).
  instanceUrl String           @default("")
  /// Owner, group or organisation whose projects are tracked.
  externalOwner String?
  /// Permissions actually granted by the provider.
  permissions   String[]
  status        IntegrationStatus @default(NOT_CONNECTED)
  lastSyncedAt  DateTime?         @db.Timestamptz(3)
  lastSyncError String?
  credentialsCiphertext String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots ProjectSnapshot[]
  issues    IssueSnapshot[]
  milestones MilestoneSnapshot[]
  syncRuns  SyncRun[]

  @@unique([userId, provider, instanceUrl])
  @@index([userId])
}

/// Normalised project data kept only to render the dashboard, with its source
/// and its fetch date. No private source code content is stored.
model ProjectSnapshot {
  id           String              @id @default(cuid())
  connectionId String
  provider     IntegrationProvider
  externalId   String
  externalUrl  String
  name         String
  visibility   String?
  metrics      Json?
  /// Instant of the last successful fetch for this project.
  fetchedAt    DateTime            @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId, fetchedAt])
}

/// An open issue or pull request, kept only to render the dashboard.
///
/// Deliberately narrow: title, identifier, address, author, comment count, labels
/// and dates. No description, no comment text, no source code: those belong to the
/// provider and often carry things that must not be copied into another tool.
/// Closed issues are not kept: a row disappears at the next synchronisation, which
/// is what makes the list a to-do list rather than an archive.
model IssueSnapshot {
  id           String              @id @default(cuid())
  connectionId String
  provider     IntegrationProvider
  /// Provider identifier, kept so a re-run updates instead of duplicating.
  externalId   String
  kind         IssueKind
  /// Repository full name, for example "owner/repo".
  repository   String
  number       Int
  title        String
  url          String
  authorLogin  String?
  /// Logins of the assignees. Empty means nobody picked it up yet, which is a state
  /// worth seeing, not a missing value.
  assignees    String[]
  /// Milestone title, as displayed by the provider. `null` means "no milestone":
  /// GitHub has no milestone notion beyond a title here, so no foreign key is kept.
  milestone    String?
  commentsCount Int
  labels       String[]
  /// Instant the issue was opened at the provider.
  openedAt     DateTime            @db.Timestamptz(3)
  /// Instant of the last activity at the provider (comment, label, edit).
  activityAt   DateTime            @db.Timestamptz(3)
  fetchedAt    DateTime            @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId, fetchedAt])
  @@index([connectionId, kind, openedAt])
  @@index([connectionId, milestone])
}

/// A milestone, kept to show progress and due dates.
///
/// The counters come from the provider and cover everything attached to the
/// milestone, not only the issues kept here: they are the authoritative figures, and
/// the interface labels them as such instead of recomputing a smaller number.
model MilestoneSnapshot {
  id           String              @id @default(cuid())
  connectionId String
  provider     IntegrationProvider
  externalId   String
  /// Repository full name, for example "owner/repo".
  repository   String
  number       Int
  title        String
  /// "open" or "closed", as the provider reports it.
  state        String
  /// Provider due date. GitHub stores a time on it, which is meaningless: only the day
  /// is displayed, in UTC, like every other date of this project.
  dueOn        DateTime?           @db.Timestamptz(3)
  issuesOpen   Int
  issuesClosed Int
  url          String
  fetchedAt    DateTime            @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId, state, dueOn])
}

/// One synchronisation attempt, kept so freshness and failures stay observable.
///
/// A run is opened before the first provider request and closed in every outcome —
/// success, partial completion or failure — so it can never end up as a `RUNNING`
/// row without a process. Counters describe what the run actually did:
/// - `fetched` counts provider items read (projects, issues and pull requests,
///   milestones);
/// - `created` and `updated` count snapshot rows first seen versus refreshed;
/// - `skipped` and `failed` count repositories, the unit the run bound and provider
///   refusals operate on. Both mean "not read": their data is unknown, never zero.
///
/// Only a safe summary is stored, never a token, a response body or a provider URL
/// carrying credentials. Retention is documented in `docs/architecture/overview.md`
/// and applied by `npm run db:cleanup`.
model SyncRun {
  id           String        @id @default(cuid())
  connectionId String
  status       SyncRunStatus @default(RUNNING)
  startedAt    DateTime      @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime?     @db.Timestamptz(3)
  fetched      Int           @default(0)
  created      Int           @default(0)
  updated      Int           @default(0)
  skipped      Int           @default(0)
  failed       Int           @default(0)
  /// Bounded retries used by this run (transient failures only).
  retries      Int           @default(0)
  /// Safe error code for a failed run, for example "RATE_LIMITED (HTTP 403)".
  errorSummary String?

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
}

/// One evaluated warning about the owner's data (see `src/modules/alerts`).
///
/// The row never stores free text: `inputs` holds the message inputs as plain strings
/// (amounts, names, dates, computed gaps) and the French reason is recomputed from them
/// at render time, so a forged request can never write the sentence a page displays.
/// The `fingerprint` (rule + entity + period) is unique per owner: re-evaluating the
/// same condition refreshes the row instead of duplicating it, and the unicity also
/// absorbs a concurrent double evaluation.
///
/// Alerts are observations only — no rule ever writes to the ledger.
model Alert {
  id          String      @id @default(cuid())
  userId      String
  kind        AlertKind
  /// Stable identity of the watched condition: rule + entity + period.
  fingerprint String
  status      AlertStatus @default(ACTIVE)
  /// Message inputs, strings only, recomputed into the displayed reason.
  inputs      Json
  /// When the current open episode started (reset on every re-trigger).
  triggeredAt DateTime    @default(now()) @db.Timestamptz(3)
  /// Last evaluation that still saw the condition.
  lastSeenAt  DateTime    @db.Timestamptz(3)
  dismissedAt DateTime?   @db.Timestamptz(3)
  resolvedAt  DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, status])
}

/// One rule's configuration, per owner and kind.
///
/// A missing row means "defaults" (`ALERT_RULE_DEFAULTS` in `src/modules/alerts`),
/// so the engine works before any settings are saved. Only the thresholds that make
/// sense for a kind are set: an amount for `LOW_BALANCE` and `UNUSUAL_EXPENSE` (with
/// its currency — amounts in another currency are never compared, they are skipped),
/// a percentage for `BUDGET_OVERRUN`, a number of days for `STALE_INTEGRATION` and
/// `OVERDUE_EVENT`.
model AlertRule {
  id                String    @id @default(cuid())
  userId            String
  kind              AlertKind
  enabled           Boolean   @default(true)
  thresholdAmount   Decimal?  @db.Decimal(18, 2)
  thresholdCurrency String?   @db.Char(3)
  thresholdPercent  Decimal?  @db.Decimal(6, 2)
  thresholdDays     Int?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}
