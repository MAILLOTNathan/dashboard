# Fictitious values only. Copy to .env and replace every secret locally.
# Never commit a real .env: only this file is versioned.

# --- Public configuration (safe for the browser) -----------------------------
# Only NEXT_PUBLIC_* variables are exposed to the client bundle.
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_DEFAULT_TIME_ZONE=Europe/Paris

# --- Server-only configuration ----------------------------------------------
# PostgreSQL connection string. Never exposed to the browser.
DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/dashboard?schema=public

# Auth.js session secret: 32 bytes minimum.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-fictitious-random-secret-at-least-32-bytes

# Set to false when the app is served behind a trusted proxy that sets the host.
AUTH_TRUST_HOST=true

# AES-256-GCM key protecting provider tokens at rest: 32 bytes, base64 encoded.
# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=replace-with-a-fictitious-32-byte-base64-key

# --- Owner bootstrap (no public sign-up) -------------------------------------
# Used by `npm run db:seed` and by the `seed` service of docker compose to create
# or update the single owner account. The seed runs on every `up`, so these
# values are the source of truth for the password.
# Always fictitious in this file; the real values live in the local .env only.
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=ChangeMe-Locally-2026
SEED_OWNER_NAME=Proprietaire

# --- Local PostgreSQL container (docker compose) -----------------------------
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
POSTGRES_DB=dashboard
# Host port published by the container. Change it if 5432 is already taken, and
# keep DATABASE_URL consistent (see above).
POSTGRES_PORT=5432
